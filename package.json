{
  "name": "x",
  "displayName": "X",
  "description": "Just save your time",
  "version": "0.0.10",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "MyHelpfulExtension.prepareTerminals",
        "title": "X: Prepare terminals"
      },
      {
        "command": "MyHelpfulExtension.prepareStashMessage",
        "title": "X: Prepare stash message"
      },
      {
        "command": "MyHelpfulExtension.nextTerminal",
        "title": "X: Select next terminal"
      },
      {
        "command": "MyHelpfulExtension.runSuperAgent",
        "title": "X: Run super agent"
      }
    ]
  },
  "scripts": {
    "build": "npm run compile && vsce package",
    "compile": "tsc -p ./",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "pretest": "npm run compile && npm run lint"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.110.0",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vscode/test-electron": "^2.3.4",
    "eslint": "^8.47.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "typescript": "^5.9.3"
  }
}
